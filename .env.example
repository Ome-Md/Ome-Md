# Local setup generates these values securely; do not commit .env.local.
DATABASE_URL=
AUTH_MODE=local
DEMO_MODE=false
ACADEMY_DATA_DIR=.academy-data

# Hosted deployment: configure these in Vercel and use Supabase PostgreSQL.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AUTH_MODE=supabase
# DATABASE_URL=your-supabase-server-connection-string
# DEMO_MODE=false
# NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYMENT_DOMAIN
# SUPABASE_SERVICE_ROLE_KEY=
# ACADEMY_ADMIN_EMAIL=
